# Server-only credentials. Copy to .env. Never prefix with VITE_.
PORT=3001
APP_ORIGIN=http://localhost:5173

# Tatum Sui Testnet gRPC gateway
TATUM_API_KEY=
TATUM_RPC_URL=https://sui-testnet-grpc.gateway.tatum.io

# OpenRouter: use the free router, subject to provider availability and rate limits
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Walrus Memory Mainnet account and delegate key (server only)
WALRUS_MEMORY_ACCOUNT_ID=
WALRUS_MEMORY_DELEGATE_KEY=
WALRUS_MEMORY_SERVER_URL=https://relayer.memory.walrus.xyz
